   "execution_count": 21,
   "id": "e76c14a4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# We are working with one file at a time for now.\n",
    "# Read in the image data\n",
    "image = io.imread(\"extra/data/mole.jpg\") "
   ]
  },
