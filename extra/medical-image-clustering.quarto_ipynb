      "        Red     Green      Blue   colour\n",
      "0  0.905882  0.576471  0.627451  #e793a0\n",
      "1  0.913725  0.592157  0.639216  #e997a3\n",
      "2  0.913725  0.592157  0.639216  #e997a3\n",
      "3  0.925490  0.596078  0.647059  #ec98a5\n",
